# DKU Leadership Resource Bank — server environment template.
# Copy to /opt/resourcebank/.env (or server/.env for local) and fill in.
# NEVER commit the filled copy.

# Shared admin password (choose a strong one; this is the only credential).
ADMIN_PASSWORD=change-me

# HMAC secret for the rb_session cookie (generate: openssl rand -base64 32).
SESSION_SECRET=change-me-too

# Express port (Nginx proxies /api here; RB_PORT also accepted as an alias).
PORT=8787

# Search delay: omit for the honest 25s simulation, or set 300ms for dev/tests.
# FAST_MODE=300ms

# SQLite location (relative to server cwd; defaults to data/rb.sqlite).
# DATA_DIR=/var/lib/resourcebank

# ── Real web search (leave everything below unset to keep the mock provider) ──
# DKU NewAPI gateway (OpenAI-compatible) handles query planning, page
# extraction, scoring and dedup. Base URL already defaults to the gateway.
# LLM_BASE_URL=https://aichat.dukekunshan.edu.cn:3443/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gemini-3.5-flash    (exact name from the gateway's model list)
# LLM_SEARCH_MODEL=             (optional web-connected model for candidate search; falls back to LLM_MODEL)
# LLM_TIMEOUT_MS=120000         (per-LLM-call timeout)
# SEARCH_SOURCE=tavily          (off | tavily — the gateway exposes no web-search model)
# TAVILY_API_KEY=tvly-...       (required for SEARCH_SOURCE=tavily; free tier = 1000 searches/mo)
# TAVILY_BASE_URL=https://api.tavily.com  (test/proxy hook for compatible endpoints)
# SEARXNG_URL=http://localhost:8888  (reserved for the planned SearXNG source)
# SEARCH_QUALITY_FLOOR=70       (drafts below this LLM score never reach the review list)
# SEARCH_JOB_TIMEOUT_MS=900000  (stale-job sweep; defaults to 15min when live search is on)
