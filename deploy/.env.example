# DKU Leadership Resource Bank — server environment template.
# Copy to /opt/resourcebank/.env (or server/.env for local) and fill in.
# NEVER commit the filled copy.

# Shared admin password (choose a strong one; this is the only credential).
ADMIN_PASSWORD=change-me

# HMAC secret for the rb_session cookie (generate: openssl rand -base64 32).
SESSION_SECRET=change-me-too

# Express port (Nginx proxies /api here).
PORT=8787

# Search delay: omit for the honest 25s simulation, or set 300ms for dev/tests.
# FAST_MODE=300ms

# SQLite location (relative to server cwd; defaults to data/rb.sqlite).
# DATA_DIR=/var/lib/resourcebank
